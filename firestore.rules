rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      let adminRef = get(/databases/$(database)/documents/admin_users/users);
      let adminEmails = adminRef.data.emails;
      return request.auth.token.email == 'arnold.darwin@gmail.com' || request.auth.token.email in adminEmails;
    }
    
    // Allow public read access to telegram_messages collection
    match /telegram_messages/{document=**} {
      allow read: if true;
      // Allow authenticated users (Cloud Functions, local scripts with service account) to write
      allow write: if request.auth != null;
    }
    
    // Admin users collection - only super admin can manage, all admins can read
    match /admin_users/{document=**} {
      allow read: if isAdmin();
      allow write: if request.auth.token.email == 'arnold.darwin@gmail.com';
    }
    
    // Telegram channels collection - only admins can access
    match /telegram_channels/{document=**} {
      allow read: if isAdmin();
      allow write: if request.auth != null; // Allow local script to update
    }
    
    // Restrict metadata collection to authenticated users only
    match /telegram_metadata/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Default rule for any other collections (deny all)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
