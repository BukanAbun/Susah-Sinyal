<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin - Telegram Channel Manager</title>

    <!-- Firebase SDK -->
    <script defer src="/__/firebase/12.12.1/firebase-app-compat.js"></script>
    <script defer src="/__/firebase/12.12.1/firebase-firestore-compat.js"></script>
    <script defer src="/__/firebase/12.12.1/firebase-auth-compat.js"></script>
    <script defer src="/__/firebase/init.js?useEmulator=false"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        .header p {
            font-size: 1em;
            opacity: 0.95;
            margin-bottom: 20px;
        }

        .user-info {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            display: inline-block;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
        }

        .user-info strong {
            margin-right: 20px;
        }

        .logout-btn {
            background: #ff6b6b;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.9em;
            transition: background 0.3s;
        }

        .logout-btn:hover {
            background: #ff5252;
        }

        .auth-section {
            display: none;
            text-align: center;
            padding: 40px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }

        .auth-section.show {
            display: block;
        }

        .auth-section h2 {
            margin-bottom: 20px;
            color: #667eea;
        }

        .auth-section p {
            margin-bottom: 20px;
            color: #666;
        }

        .auth-section button {
            background: #667eea;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1em;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .auth-section button:hover {
            background: #5568d3;
        }

        .content {
            display: none;
        }

        .content.show {
            display: block;
        }

        .panel {
            background: white;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        }

        .panel h2 {
            color: #667eea;
            margin-bottom: 20px;
            font-size: 1.5em;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #333;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
            transition: border 0.3s;
        }

        .form-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .button-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 5px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

        .btn-primary {
            background: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background: #5568d3;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .btn-secondary {
            background: #f5f5f5;
            color: #333;
        }

        .btn-secondary:hover {
            background: #e0e0e0;
        }

        .btn-danger {
            background: #ff6b6b;
            color: white;
        }

        .btn-danger:hover {
            background: #ff5252;
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .admin-list, .channel-list {
            list-style: none;
        }

        .admin-item, .channel-item {
            background: #f9f9f9;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-left: 4px solid #667eea;
        }

        .admin-item-info, .channel-item-info {
            flex: 1;
        }

        .admin-item-email {
            font-weight: 600;
            color: #333;
        }

        .admin-item-super {
            background: #ffd700;
            color: #333;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 0.8em;
            font-weight: 600;
            margin-left: 10px;
        }

        .channel-item-name {
            font-weight: 600;
            color: #333;
            margin-bottom: 5px;
        }

        .channel-item-url {
            font-size: 0.9em;
            color: #666;
            word-break: break-all;
            margin-bottom: 5px;
        }

        .channel-item-meta {
            font-size: 0.85em;
            color: #999;
        }

        .channel-item-actions {
            display: flex;
            gap: 8px;
            margin-left: 15px;
        }

        .alert {
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            display: none;
        }

        .alert.show {
            display: block;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-warning {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        .alert-info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            vertical-align: middle;
            margin-left: 10px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .empty-state {
            text-align: center;
            color: #999;
            padding: 30px;
        }

        .empty-state p {
            margin-bottom: 15px;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 2em;
            }

            .panel {
                padding: 20px;
            }

            .button-group {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .admin-item, .channel-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .channel-item-actions {
                width: 100%;
                margin-left: 0;
                margin-top: 10px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📱 Admin Panel</h1>
            <p>Manage Telegram Channels & Admin Users</p>
            <div class="user-info" id="userInfo" style="display:none;">
                <strong id="userEmail"></strong>
                <button class="logout-btn" onclick="logout()">Logout</button>
            </div>
        </div>

        <!-- Auth Section -->
        <div id="authSection" class="auth-section">
            <h2>Access Restricted</h2>
            <p>This admin panel is only accessible to authorized administrators.</p>
            <p>Please sign in with your Google account.</p>
            <button onclick="loginWithGoogle()">Sign in with Google</button>
        </div>

        <!-- Main Content -->
        <div id="content" class="content">
            <!-- Alerts -->
            <div id="alerts"></div>

            <!-- Admin Users Management -->
            <div class="panel">
                <h2>👥 Manage Admin Users</h2>
                <p style="color: #666; margin-bottom: 15px;">Only the super admin (arnold.darwin@gmail.com) can add or remove admin users.</p>

                <div class="form-group">
                    <label for="adminEmail">Admin Email Address</label>
                    <input type="email" id="adminEmail" placeholder="admin@example.com">
                </div>

                <div class="button-group">
                    <button class="btn btn-primary" onclick="addAdmin()" id="addAdminBtn">Add Admin</button>
                    <button class="btn btn-secondary" onclick="loadAdminList()" id="refreshAdminsBtn">Refresh</button>
                </div>

                <div id="adminListContainer" style="margin-top: 20px;">
                    <ul class="admin-list" id="adminList">
                        <div class="empty-state">
                            <p>Loading admin users...</p>
                        </div>
                    </ul>
                </div>
            </div>

            <!-- Channel Management -->
            <div class="panel">
                <h2>📡 Manage Telegram Channels</h2>
                <p style="color: #666; margin-bottom: 15px;">
                    Add the channels you want to monitor. To fetch posts, run: <code style="background: #f5f5f5; padding: 3px 8px; border-radius: 3px;">npm run scrape -- https://t.me/s/channelname</code>
                </p>

                <div class="form-group">
                    <label for="channelUrl">Channel URL</label>
                    <input type="url" id="channelUrl" placeholder="https://t.me/s/channelname">
                </div>

                <div class="form-group">
                    <label for="channelName">Channel Name (optional)</label>
                    <input type="text" id="channelName" placeholder="My Trading Channel">
                </div>

                <div class="button-group">
                    <button class="btn btn-primary" onclick="addChannel()" id="addChannelBtn">Add Channel</button>
                    <button class="btn btn-secondary" onclick="loadChannels()" id="refreshChannelsBtn">Refresh</button>
                </div>

                <div id="channelListContainer" style="margin-top: 20px;">
                    <ul class="channel-list" id="channelList">
                        <div class="empty-state">
                            <p>Loading channels...</p>
                        </div>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script src="admin.js" defer></script>
</body>
</html>
